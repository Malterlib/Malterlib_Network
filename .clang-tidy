# The malterlib-* logic checks. The naming and declaration style checks are off until the sources follow them.
Checks: >-
  -*,
  malterlib-*,
  -malterlib-header-declarations-only,
  -malterlib-struct-not-class,
  -malterlib-variable-naming,
  -malterlib-function-naming,
  -malterlib-parameter-naming,
  -malterlib-conceptual-prefix,
  -malterlib-type-naming
CheckOptions:
  malterlib.OptionsFile: ../Core/ClangTidyOptions.yaml
