Property.CMakeOutputPath_c\-ares: string = `@('.'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_c-ares_c-ares"
{
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('.'->MakeAbsolute())`->MakeAbsolute(),
			`@('../../../../External/c-ares'->MakeAbsolute())`->MakeAbsolute(),
			`@('../../../../External/c-ares'->MakeAbsolute())/include`->MakeAbsolute(),
			`@('../../../../External/c-ares'->MakeAbsolute())/src/lib`->MakeAbsolute(),
			`@('../../../../External/c-ares'->MakeAbsolute())/src/lib/include`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"CARES_BUILDING_LIBRARY",
			"HAVE_CONFIG_H=1",
			"_GNU_SOURCE",
			"_POSIX_C_SOURCE=200809L",
			"_XOPEN_SOURCE=700"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/c-ares"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "c-ares_c-ares"
	Target.BaseFileName "c-ares"
	%Group "src"
